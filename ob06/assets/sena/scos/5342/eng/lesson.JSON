"{\"rows\":6,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Preposition\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Phrase\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"on\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"touching the surface\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"on the highway\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"in\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" within an enclosed space\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"in the taxi\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"around\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"from one part to another\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"around the corner\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"next to \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"right beside\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"next to the museum \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"opposite\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"on the other side\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"opposite the museum\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "taxi stand", "type": "name"}, {"content": "a place where available taxis wait for customers", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You need a taxi? There's a taxi stand at the end of this block.", "type": "example"}, {"content": "engenn4le05ob06aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "highway", "type": "name"}, {"content": "a large road that connects towns and cities", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The highway is the fastest way to get to the airport.", "type": "example"}, {"content": "engenn4le05ob06aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "traffic jam", "type": "name"}, {"content": "when there are too many cars on the road and they can't move", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Look at this traffic jam. We're going to be late!", "type": "example"}, {"content": "engenn4le05ob06aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "road", "type": "name"}, {"content": "a flat surface that cars and other vehicles drive on", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Take this road to get to the airport.", "type": "example"}, {"content": "engenn4le05ob06aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "almost", "type": "name"}, {"content": "just a small amount less than", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Are we almost there yet?", "type": "example"}, {"content": "engenn4le05ob06aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "expressway", "type": "name"}, {"content": "a wide road for high-speed traffic", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can take the expressway and be there in an hour.", "type": "example"}, {"content": "engenn4le05ob06aud02", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le05ob06re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Find a map of your favorite city.", "type": "text"}, {"content": "Find the airport. ", "type": "text"}, {"content": "Write directions on how to get to the airport from another location. ", "type": "text"}, {"content": "Read your directions aloud to a partner.", "type": "text"}, {"content": "Listen to your partner's directions.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I locate an airport on a map.", "type": "text"}, {"content": "I write directions to a place.", "type": "text"}, {"content": "I express locations of places.", "type": "text"}, {"content": "I communicate directions to my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn4le05ob06re2aud01", "images": [{"image": "engenn4le05ob06re2img05.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn4le05ob06re2img05.jpg", "id": 1, "time": "10", "text": "<span class=\"strong\">Sally</span>: I'm flying to Bilbao soon. And from there ... Pamplona! Where is the airport? How do I get to the airport?<br/><span class=\"strong\">Concierge</span>: You could take a taxi. Walk out of the hotel, turn right and walk straight for a block to the taxi stand. It's around the corner, next to the museum.<br/><span class=\"strong\">Sally</span>: Thanks!"}, {"image": "engenn4le05ob06re2img02.jpg", "id": 2, "time": "21000", "text": "<span class=\"strong\">Taxi driver</span>: The airport? Fine, get in the taxi. I can drive on the highway to the airport.<br/><span class=\"strong\">Sally</span>: How long does it take to get to the airport?<br/><span class=\"strong\">Taxi driver</span>: About an hour.<br/><span class=\"strong\">Sally</span>: My flight is in two hours! I have to be at the airport now. Is the highway the best way?"}, {"image": "engenn4le05ob06re2img01.jpg", "id": 3, "time": "40000", "text": "<span class=\"strong\">Taxi driver</span>: Absolutely. We can take the expressway too. There's a traffic jam on the other road.<br/><span class=\"strong\">Sally</span>: Okay ... are we almost there yet? Is it near here?<br/><span class=\"strong\">Taxi driver</span>: No, Miss ... we're still opposite the museum!"}], "coverimg": "en