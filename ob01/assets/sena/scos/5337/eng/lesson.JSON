]}]}, {"id": 11, "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " Let's talk about Spain.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn4le05ob01re7pdf01.pdf", "type": "pdf"}]}], "id": 0, "responses": [{"correct": 1, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn4le05ob01re2aud01", "images": [{"image": "engenn4le05ob01re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn4le05ob01re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: It's 9:20 a.m. Why is the tourist office closed? They're late. That's so rude.<br/>\n<span class=\"strong\">Clerk</span>: Good morning! Sorry I'm not on time today. How can I help you? <br/>\n<span class=\"strong\">Sally</span>: Could you tell me what to see in Spain? I'm sorry. I just had a really bumpy flight. I'm a little flustered.<br/>\n<span class=\"strong\">Clerk</span>: Of course. Shall we go inside?<br/>\n<span class=\"strong\">Sally</span>: Yes, please.<br/>", "time": "100"}, {"image": "engenn4le05ob01re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Clerk</span>: Okay, so for art lovers, I suggest the Guggenheim Museum in Bilbao. <br/>\n<span class=\"strong\">Sally</span>: I'm going to see it.", "time": "23700"}, {"image": "engenn4le05ob01re2img03.jpg", "id": 3, "text": "<span class=\"strong\">Clerk</span>: Okay! You might want to try La Tomatina festival in Bu\u00f1ol. It's a tomato fight!<br/>\n<span class=\"strong\">Sally</span>:  Sounds messy, but fun!", "time": "31000"}, {"image": "engenn4le05ob01re2img02.jpg", "id": 4, "text": "<span class=\"strong\">Clerk</span>: Great. And then you could go to the Running of the Bulls in Pamplona.<br/>\n<span class=\"strong\">Sally</span>: That sounds exciting! Is it safe?<br/>\n<span class=\"strong\">Clerk</span>: It can be dangerous. <br/>\n<span class=\"strong\">Sally</span>: Dangerous? Maybe I can watch from a balcony.", "time": "41000"}, {"image": "engenn4le05ob01re2img02.jpg", "id": 5, "text": "<span class=\"strong\">Clerk</span>: Okay! Also, you may want to visit Toledo. It has medieval architecture.<br/>\n<span class=\"strong\">Sally</span>: I'm going to do that.<br />\n<span class=\"strong\">Clerk</span>: Let's take a look at these pamphlets ...", "time": "54000"}], "coverimg": "engenn4le05ob01re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}