: [{"type": "heading", "content": " Talking About Intentions and Plans"}, {"type": "describer", "content": "You can use these phrases to talk about intentions and plans:<br/><br/>I'd like to \u2026<br/> I would rather \u2026<br/> I intend on \u2026 <br/>I'm planning to \u2026"}, {"type": "example", "content": " I'd like to visit a restaurant."}, {"type": "example", "content": "I'd rather go to a vegetarian restaurant."}, {"type": "example", "content": "I intend on having steak for dinner."}, {"type": "example", "content": "I'm planning to go out for dinner with my friend."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Infinitives of Purpose"}, {"type": "describer", "content": "Infinitives are the structure to + verb, like <span class = \"strong\">to go</span> or <span class = \"strong\">to see</span>. <br/><br/>Infinitives of purpose are infinitives you place in phrases within a sentence. They explain why the action happens."}, {"type": "example", "content": "You can call them to make a reservation."}, {"type": "example", "content": "You have to take a taxi to arrive on time. "}, {"type": "example", "content": "Take the bus to arrive quickly."}, {"type": "example", "content": "To get there fast, I suggest you take a bus."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "steak"}, {"type": "definition", "content": "a slice of meat that is grilled or fried"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The steak is delicious at that restaurant."}, {"type": "audio", "content": "engenn4le05ob10aud03"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about travel."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "terrific"}, {"type": "definition", "content": "very good; excellent"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: There is a terrific steak restaurant down the street."}, {"type": "audio", "content": "engenn4le05ob10aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "authentic"}, {"type": "definition", "content": "real; true"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I want to eat at an authentic Spanish restaurant."}, {"type": "audio", "content": "engenn4le05ob10aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "bus"}, {"type": "definition", "content": "a large vehicle that drives on the road and carries many people"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Take the bus to the Spanish restaurant."}, {"type": "audio", "content": "engenn4le05ob10aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "train"}, {"type": "definition", "content": "a large vehicle with many cars that runs on tracks"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The train is the best way to travel in Spain."}, {"type": "audio", "content": "engenn4le05ob10aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "taxi"}, {"type": "definition", "content": "a car that people pay to use to travel in a city"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It is far. I suggest you take a taxi."}, {"type": "audio", "content": "engenn4le05ob10aud04"}]}, {"type": "background_image", "content": "engenn4le05ob10re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a dialogue about visiting a new city with a friend."}, {"type": "text", "content": "Talk about where to go and what to do."}, {"type": "text", "content": "Ask the hotel concierge what you can do."}, {"type": "text", "content": "Write 10-12 lines in your dialogue."}, {"type": "text", "content": "Practice the dialogue with you partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about where to go in a city."}, {"type": "text", "content": "I express my intentions."}, {"type": "text", "content": "I ask for suggestions when I visit a new city."}, {"type": "text", "content": "I write a dialogue about visiting a city."}]}], "type": "sena"}